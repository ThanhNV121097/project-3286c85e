# PostgreSQL user for local compose database.
POSTGRES_USER=app

# PostgreSQL password for local compose database.
POSTGRES_PASSWORD=app_secret

# PostgreSQL database name for local compose database.
POSTGRES_DB=app

# Backend host port.
BACKEND_PORT=8080

# Frontend host port.
FRONTEND_PORT=3000

# Browser-visible backend base URL used by frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8080
