# Local PostgreSQL username.
POSTGRES_USER=app

# Local PostgreSQL password. Replace outside git for local runs.
POSTGRES_PASSWORD=app_secret

# Local PostgreSQL database name.
POSTGRES_DB=app

# Host port for backend.
BACKEND_PORT=8080

# Host port for frontend.
FRONTEND_PORT=3000

# Browser-visible backend API origin.
NEXT_PUBLIC_API_URL=http://localhost:8080
